---
import TechCard from "./TechCard.astro";

import docker from "../assets/icons/docker.png";
import git from "../assets/icons/git.png";
import mariadb from "../assets/icons/mariadb.png";
import astroIcon from "../assets/icons/astro.svg";
import rust from "../assets/icons/rust.png";
import typescript from "../assets/icons/typescript.png";
import java from "../assets/icons/java.png";
import linux from "../assets/icons/tux.png";

type Level = "Básico" | "Intermedio" | "Avanzado";

interface Tech {
    name: string;
    icon: string;
    level: Level;
    }

const stack: Tech[] = [
    {
        name: "Docker",
        icon: docker.src,
        level: "Básico",
    },
    {
        name: "Git",
        icon: git.src,
        level: "Básico",
        
    },
    {
        name: "MariaDB",
        icon: mariadb.src,
        level: "Intermedio",
        
    },
    {
        name: "Java",
        icon: java.src,
        level: "Intermedio",
    },
    {
        name: "Rust",
        icon: rust.src,
        level: "Básico",
        
    },
    {
        name: "Astro",
        icon: astroIcon.src,
        level: "Intermedio",
    },
    {
        name: "TypeScript",
        icon: typescript.src,
        level: "Básico",
    },
    {
        name: "Linux",
        icon: linux.src,
        level: "Intermedio"
    }
];
---

<section class="mx-auto mt-32 max-w-6xl px-6">
    <div class="mb-12 text-center">
        <h2 class="text-4xl font-bold">
            Stack Tecnológico
        </h2>

        <p class="mt-3 text-subtext">
            Herramientas y tecnologías que utilizo en mis proyectos.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((tech) => (
            <TechCard
                name={tech.name}
                icon={tech.icon}
                level={tech.level}
            />
        ))}
    </div>
</section>