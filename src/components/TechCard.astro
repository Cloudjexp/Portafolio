---
interface Props {
    name: string;
    icon: string
}

const { name, icon } = Astro.props;
---

<div class="rounded-2xl border border-white/10 bg-surface p-6 text-center transition duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-xl">
    <img
        src={icon}
        alt={name}
        class="mx-auto mb-4 h-16 w-16 object-contain" />
    <h3 class="text-xl font-semibold">
        {name}        
    </h3>
</div>