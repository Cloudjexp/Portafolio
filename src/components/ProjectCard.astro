---
interface Props {
    title: string;
    description: string;
    github: string;
    tech: string[];
    image?: string;
}

const { title, description, github, tech, image } = Astro.props;
---

<div
    class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-2xl"
>
    {
        image ? (
            <img
                src={image}
                alt={title}
                class="mb-6 h-56 w-full rounded-2xl object-cover"
            />
        ) : (
            <div
                class="mb-6 flex h-56 items-center justify-center rounded-2xl bg-gradient-to-br from-accent/20 via-base to-purple-500/20"
            >
                <div class="text-center">
                    <h3 class="text-4xl font-bold">{title}</h3>

                    <p class="mt-2 text-subtext">
                        Personal Portfolio
                    </p>
                </div>
            </div>
        )
    }

    <!-- Título -->
    <h3 class="text-2xl font-bold">
        {title}
    </h3>

    <!-- Descripción -->
    <p class="mt-3 text-subtext">
        {description}
    </p>

    <!-- Tecnologías -->
    <div class="mt-6 flex flex-wrap gap-2">
        {
            tech.map((item) => (
                <span
                    class="rounded-full bg-base px-3 py-1 text-sm text-accent"
                >
                    {item}
                </span>
            ))
        }
    </div>

    <!-- Botón -->
    <a
        href={github}
        target="_blank"
        class="mt-6 inline-flex items-center rounded-full bg-accent/10 px-5 py-2 font-medium text-accent transition-all duration-300 hover:bg-accent hover:text-base"
    >
        GitHub →
    </a>
</div>