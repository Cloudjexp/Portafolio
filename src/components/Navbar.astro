<nav class="sticky top-0 z-50 relative" aria-label="Navegación principal">
    <div
        class="mx-auto mt-5 flex w-11/12 max-w-6xl items-center justify-between rounded-3xl border border-white/10 bg-white/5 px-8 py-4 shadow-2xl shadow-black/20 ring-1 ring-white/5 backdrop-blur-2xl"
    >
        <a
            href="#top"
            class="text-3xl font-black tracking-tight transition-colors duration-300 hover:text-accent"
        >
            <span class="text-accent">Cloud</span><span class="text-text">Jex</span>
        </a>

        <!-- Botón móvil -->
        <button
            id="menu-btn"
            class="text-text lg:hidden"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span id="menu-icon" class="text-3xl leading-none">☰</span>
        </button>

        <!-- Menú escritorio -->
        <div class="hidden items-center gap-6 lg:flex">
            <a href="#proyectos" class="transition-colors duration-300 hover:text-accent">
                Proyectos
            </a>

            <a href="#stack" class="transition-colors duration-300 hover:text-accent">
                Stack
            </a>

            <a href="#about" class="transition-colors duration-300 hover:text-accent">
                Sobre mí
            </a>

            <a
                href="#contacto"
                class="rounded-xl px-3 py-2 transition-all duration-300 hover:bg-white/5 hover:text-accent"
            >
                Contacto
            </a>
        </div>
    </div>

    <!-- Menú móvil -->
    <div
        id="mobile-menu"
        class="pointer-events-none absolute left-1/2 top-full mt-3 w-11/12 max-w-6xl -translate-x-1/2 -translate-y-4 rounded-3xl border border-white/10 bg-white/5 p-6 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 ease-out lg:hidden"
    >
        <div class="flex flex-col gap-5 text-lg">
            <a href="#proyectos">Proyectos</a>
            <a href="#stack">Stack</a>
            <a href="#about">Sobre mí</a>
            <a href="#contacto">Contacto</a>
        </div>
    </div>
</nav>

<script is:inline>
const button = document.getElementById("menu-btn");
const menu = document.getElementById("mobile-menu");
const icon = document.getElementById("menu-icon");

function openMenu() {
    menu.classList.remove(
        "opacity-0",
        "-translate-y-4",
        "pointer-events-none"
    );

    menu.classList.add(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto"
    );

    icon.textContent = "✕";
    button.setAttribute("aria-expanded", "true");
}

function closeMenu() {
    menu.classList.remove(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto"
    );

    menu.classList.add(
        "opacity-0",
        "-translate-y-4",
        "pointer-events-none"
    );

    icon.textContent = "☰";
    button.setAttribute("aria-expanded", "false");
}

button.addEventListener("click", (event) => {
    event.stopPropagation();

    if (menu.classList.contains("opacity-100")) {
        closeMenu();
    } else {
        openMenu();
    }
});

menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
});

document.addEventListener("click", (event) => {
    if (
        !menu.contains(event.target) &&
        !button.contains(event.target)
    ) {
        closeMenu();
    }
});
</script>