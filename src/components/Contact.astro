---
import GithubIcon from "../assets/icons/github.svg";
import EmailIcon from "../assets/icons/gmail.svg";
import LinkedinIcon from "../assets/icons/linkedin.png";
---

<section
    id="contacto"
    class="mx-auto mt-24 max-w-6xl px-6"
>
    <h2 class="text-center text-4xl font-bold text-text">
        Contacto
    </h2>

    <p class="mt-4 text-center text-lg md:text-xl leading-8 text-subtext">
        ¿Te interesa colaborar o tienes alguna pregunta? No dudes en ponerte en contacto conmigo.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">

        <!-- GitHub -->
        <a
            href="https://github.com/Cloudjexp"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:border-accent/40 hover:shadow-xl"
        >
            <img
                src={GithubIcon.src}
                alt="GitHub"
                class="h-12 w-12 transition-transform duration-300 group-hover:scale-110"
            />

            <h3 class="mt-5 text-2xl font-bold text-text">
                GitHub
            </h3>

            <p class="mt-2 text-subtext">
                @Cloudjexp
            </p>

            <p class="mt-6 font-medium text-accent">
                Ver perfil →
            </p>
        </a>

        <!-- Email -->
        <a
            href="mailto:lesterjavier.velasquez@gmail.com"
            class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:border-accent/40 hover:shadow-xl"
        >
            <img
                src={EmailIcon.src}
                alt="Email"
                class="h-12 w-12 transition-transform duration-300 group-hover:scale-110"
            />

            <h3 class="mt-5 text-2xl font-bold text-text">
                Email
            </h3>

            <p class="mt-2 break-all text-subtext">
                lesterjavier.velasquez@gmail.com
            </p>

            <p class="mt-6 font-medium text-accent">
                Escribirme →
            </p>
        </a>

        <!-- LinkedIn -->
        <a
            href="https://www.linkedin.com/in/lester-javier-velazquez-ab4b53351/"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:border-accent/40 hover:shadow-xl"
        >
            <img
                src={LinkedinIcon.src}
                alt="LinkedIn"
                class="h-12 w-12 transition-transform duration-300 group-hover:scale-110"
            />

            <h3 class="mt-5 text-2xl font-bold text-text">
                LinkedIn
            </h3>

            <p class="mt-2 text-subtext">
                /in/lester-javier-velazquez
            </p>

            <p class="mt-6 font-medium text-accent">
                Conectar →
            </p>
        </a>

    </div>
</section>