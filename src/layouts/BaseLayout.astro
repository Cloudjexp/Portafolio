---
import "../styles/global.css"
interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body class="min-h-screen bg-base text-text overflow-x-hidden">
        <slot />
    </body>
</html>